# Telegram bot token from @BotFather
BOT_TOKEN=

# Your Telegram user ID (from @userinfobot). These IDs may use the bot with Claude.
# Several IDs: separate with commas.
OWNER_IDS=

# Friends use the free model only and can never use Claude, which runs on your
# own Pro subscription. Easiest: send /invite to the bot and share the link.
# Or list their Telegram IDs here (several: commas).
GUEST_IDS=

# Free model for guests (and for you when you pick it with /model).
# Groq by default: make a free key at https://console.groq.com/keys
FREE_LLM_API_KEY=
# Any OpenAI-style API works; these are the Groq defaults.
FREE_LLM_BASE_URL=https://api.groq.com/openai/v1
FREE_LLM_MODEL=openai/gpt-oss-120b
# Used when the main one hits its per-minute limit (each Groq model has its own).
FREE_LLM_FALLBACK_MODELS=openai/gpt-oss-20b

# Claude Pro login for Claude Code: run `claude setup-token` on your own computer
# and paste the token it prints.
CLAUDE_CODE_OAUTH_TOKEN=

# Your timezone, as an IANA name (Europe/Berlin, Asia/Tbilisi, America/New_York, ...).
# You can also change it later by telling the bot where you are.
DEFAULT_TIMEZONE=UTC

# Optional: which Claude model Claude Code uses. Empty = Claude Code's default.
# "haiku" is faster and uses less of your Pro limits; "sonnet" grades more carefully.
CLAUDE_MODEL=

# Where the database lives.
DB_PATH=/opt/macaw/data/macaw.sqlite3

LOG_LEVEL=INFO
