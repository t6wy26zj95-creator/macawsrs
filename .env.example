# Telegram bot token from @BotFather
BOT_TOKEN=

# Your Telegram user ID (from @userinfobot). These IDs may use the bot with Claude.
# Several IDs: separate with commas.
OWNER_IDS=

# Friends use the free model only and can never use Claude, which runs on your
# own Pro subscription. Easiest: send /invite to the bot and share the link.
# Or list their Telegram IDs here (several: commas).
GUEST_IDS=

# Free model for guests, for you when you pick it with /model, and for you
# whenever Claude isn't answering. Gemini is tried first, then NVIDIA, then Groq;
# each next one takes over when the one before is busy or out of its daily limit.
# Gemini: make a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave empty for the defaults: gemini-3.8-flash (20 requests a day), then two
# Flash-Lite models (about 500 a day each).
GEMINI_MODELS=
# NVIDIA: make a free key at https://build.nvidia.com (about 40 requests a minute, no daily cap)
NVIDIA_API_KEY=
# Leave empty for the defaults: openai/gpt-oss-120b, nvidia/nemotron-3-super-120b-a12b, openai/gpt-oss-20b
NVIDIA_MODELS=
# Groq by default: make a free key at https://console.groq.com/keys
FREE_LLM_API_KEY=
# Any OpenAI-style API works; these are the Groq defaults.
FREE_LLM_BASE_URL=https://api.groq.com/openai/v1
FREE_LLM_MODEL=openai/gpt-oss-120b
# Used when the main one hits its per-minute limit (each Groq model has its own).
FREE_LLM_FALLBACK_MODELS=openai/gpt-oss-20b

# Voice messages are turned into text with Groq's free Whisper. The Groq key
# above is used; set GROQ_API_KEY only if FREE_LLM_API_KEY isn't a Groq key.
GROQ_API_KEY=
# whisper-large-v3 is the most accurate; whisper-large-v3-turbo is faster.
VOICE_MODEL=whisper-large-v3

# Claude Pro login for Claude Code: run `claude setup-token` on your own computer
# and paste the token it prints.
CLAUDE_CODE_OAUTH_TOKEN=

# Your timezone, as an IANA name (Europe/Berlin, Asia/Tbilisi, America/New_York, ...).
# You can also change it later by telling the bot where you are.
DEFAULT_TIMEZONE=UTC

# Optional: which Claude model Claude Code uses. Empty = Claude Code's default.
# "haiku" is faster and uses less of your Pro limits; "sonnet" grades more carefully.
CLAUDE_MODEL=

# Book reader Mini App. Its web address must start with https://. The easiest
# way to get one: sudo bash /opt/macaw/app/deploy/reader-https.sh (it fills this in).
READER_URL=
# The reader's web server listens on this port on the server itself only.
READER_PORT=8090

# Where the database lives.
DB_PATH=/opt/macaw/data/macaw.sqlite3

LOG_LEVEL=INFO
