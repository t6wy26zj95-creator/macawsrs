[Unit]
Description=Macaw spaced-repetition Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=macaw
Group=macaw
WorkingDirectory=/opt/macaw/app
EnvironmentFile=/opt/macaw/.env
Environment=HOME=/opt/macaw
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/macaw/venv/bin/python -m macaw
Restart=on-failure
RestartSec=10

# Keep it in its own corner: it can only write to /opt/macaw.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/macaw
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Resource caps so it can never starve the other services on this server.
MemoryMax=768M
CPUQuota=50%
TasksMax=128

[Install]
WantedBy=multi-user.target
